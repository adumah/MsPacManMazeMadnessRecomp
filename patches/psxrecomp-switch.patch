+/* DMA event window (PSX_DMA_EVENT_WINDOW, guest cycles; default 1 = every
+ * word is its own deadline, the faithful timeline). MDEC, CD-ROM and GPU
+ * linked-list DMA cost 1-14 cycles per word, so a transfer otherwise makes the
+ * scheduler service every device once per word: ~38K services per 320x240
+ * video frame, one per display-list word. A slow host (Switch A57) can't keep
+ * up. With a window of N, a busy channel's next deadline is stretched to at
+ * most N cycles (never past the end of its transfer) and the advance functions
+ * move every word due in that span in one call. Other devices' events still
+ * bound each step, and guest MMIO still catches DMA up exactly
+ * (psx_devices_mmio_sync); only plain-RAM polling of a destination buffer can
+ * see words land up to N cycles late. */
+static uint32_t dma_event_window(void) {
+    static uint32_t window = 0;
+    if (window == 0) {
+        const char *e = getenv("PSX_DMA_EVENT_WINDOW");
+        long v = e ? strtol(e, NULL, 10) : 1;
+        window = v > 1 ? (uint32_t)(v > 65536 ? 65536 : v) : 1u;
+        if (window > 1u)
+            fprintf(stderr, "psxrecomp: DMA event window %u cycles "
+                            "(PSX_DMA_EVENT_WINDOW)\n", window);
+    }
+    return window;
+}
+
+/* Stretch a channel's next deadline d to the window, capped at the cycles it
+ * needs to finish `words` more words at cpw cycles each (accum already paid). */
+static uint32_t dma_windowed(uint32_t d, uint32_t words, uint32_t cpw,
+                             uint32_t accum) {
+    uint32_t window = dma_event_window();
+    if (window <= d) return d;
+    uint64_t left = (uint64_t)words * cpw;
+    left = left > accum ? left - accum : 1u;
+    if (left < window) window = (uint32_t)left;
+    return window > d ? window : d;
+}
