+#elif defined(__SWITCH__)
+/* Horizon (libnx + newlib) has no ucontext. A minimal AArch64 context
+ * switch: save the AAPCS64 callee-saved state (x19-x28, fp, lr, sp, d8-d15)
+ * of the running fiber and load the target's. Cooperative and
+ * single-threaded, like the ucontext backend. */
+#include <stdlib.h>
+#include <stdint.h>
+
+enum { PSX_FIBER_REGS = 21 };   /* x19..x30 (12), sp (1), d8..d15 (8) */
+
+typedef struct psx_fiber_impl {
+    uint64_t        regs[PSX_FIBER_REGS];
+    void*           stack;    /* NULL for the thread-fiber */
+    psx_fiber_entry entry;
+    void*           arg;
+} psx_fiber_impl;
+
+void psx_fiber_swap_a64(uint64_t* save, const uint64_t* load);
+void psx_fiber_start_a64(void);
+
+__asm__(
+    ".text\n"
+    ".balign 16\n"
+    ".global psx_fiber_swap_a64\n"
+    ".type psx_fiber_swap_a64, %function\n"
+    "psx_fiber_swap_a64:\n"
+    "    stp x19, x20, [x0, #0]\n"
+    "    stp x21, x22, [x0, #16]\n"
+    "    stp x23, x24, [x0, #32]\n"
+    "    stp x25, x26, [x0, #48]\n"
+    "    stp x27, x28, [x0, #64]\n"
+    "    stp x29, x30, [x0, #80]\n"
+    "    mov x9, sp\n"
+    "    str x9, [x0, #96]\n"
+    "    stp d8, d9, [x0, #104]\n"
+    "    stp d10, d11, [x0, #120]\n"
+    "    stp d12, d13, [x0, #136]\n"
+    "    stp d14, d15, [x0, #152]\n"
+    "    ldp x19, x20, [x1, #0]\n"
+    "    ldp x21, x22, [x1, #16]\n"
+    "    ldp x23, x24, [x1, #32]\n"
+    "    ldp x25, x26, [x1, #48]\n"
+    "    ldp x27, x28, [x1, #64]\n"
+    "    ldp x29, x30, [x1, #80]\n"
+    "    ldr x9, [x1, #96]\n"
+    "    mov sp, x9\n"
+    "    ldp d8, d9, [x1, #104]\n"
+    "    ldp d10, d11, [x1, #120]\n"
+    "    ldp d12, d13, [x1, #136]\n"
+    "    ldp d14, d15, [x1, #152]\n"
+    "    ret\n"
+    ".size psx_fiber_swap_a64, .-psx_fiber_swap_a64\n"
+    /* First entry of a new fiber: psx_fiber_create puts the fiber pointer in
+     * x19 and this stub in lr, so the first swap "returns" here. */
+    ".balign 16\n"
+    ".global psx_fiber_start_a64\n"
+    ".type psx_fiber_start_a64, %function\n"
+    "psx_fiber_start_a64:\n"
+    "    mov x0, x19\n"
+    "    bl psx_fiber_run_a64\n"
+    "    brk #0\n"
+    ".size psx_fiber_start_a64, .-psx_fiber_start_a64\n");
+
+/* Cooperative + single-threaded, so a plain static tracks who's running. */
+static psx_fiber_impl* s_current = NULL;
+
+void psx_fiber_run_a64(psx_fiber_impl* f)
+{
+    f->entry(f->arg);
+    /* The BIOS thread entry never returns normally (it switches back to its
+     * scheduler target, or trap_crashes). Reaching here is a bug. */
+    abort();
+}
+
+psx_fiber_t psx_fiber_convert_thread(void)
+{
+    if (!s_current) {
+        psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+        f->stack = NULL;       /* runs on the real thread stack */
+        s_current = f;
+    }
+    return (psx_fiber_t)s_current;
+}
+
+psx_fiber_t psx_fiber_current(void) { return (psx_fiber_t)s_current; }
+
+psx_fiber_t psx_fiber_create(size_t stack_size, psx_fiber_entry entry, void* arg)
+{
+    if (stack_size < 64u * 1024u) stack_size = 64u * 1024u;
+    psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+    if (!f) return NULL;
+    f->stack = malloc(stack_size);
+    if (!f->stack) { free(f); return NULL; }
+    f->entry = entry;
+    f->arg   = arg;
+    uintptr_t top = ((uintptr_t)f->stack + stack_size) & ~(uintptr_t)15u;
+    f->regs[0]  = (uint64_t)(uintptr_t)f;                    /* x19 */
+    f->regs[10] = 0;                                         /* x29 */
+    f->regs[11] = (uint64_t)(uintptr_t)psx_fiber_start_a64;  /* x30 */
+    f->regs[12] = (uint64_t)top;                             /* sp  */
+    return (psx_fiber_t)f;
+}
+
+void psx_fiber_switch(psx_fiber_t target)
+{
+    psx_fiber_impl* to   = (psx_fiber_impl*)target;
+    psx_fiber_impl* from = s_current;
+    if (!to || to == from) return;
+    s_current = to;
+    psx_fiber_swap_a64(from->regs, to->regs);
+    /* Resumed: s_current was set back to `from` by whoever switched here. */
+}
+
+void psx_fiber_destroy(psx_fiber_t fiber)
+{
+    psx_fiber_impl* f = (psx_fiber_impl*)fiber;
+    if (!f) return;
+    free(f->stack);
+    free(f);
+}
+
 #else /* POSIX: ucontext */
 
 #ifndef _XOPEN_SOURCE
